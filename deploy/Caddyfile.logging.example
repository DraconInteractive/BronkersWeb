# Merge this into the existing Caddyfile by replacing only the Bronkers domain
# block. Keep the existing loopback static server on :43187 and other sites.
bronkers.dracon.au {
    handle /api/* {
        reverse_proxy 127.0.0.1:43188
    }
    handle {
        reverse_proxy 127.0.0.1:43187
    }
}
